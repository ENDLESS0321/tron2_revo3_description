      <geometry>
        <box size="0.02505 0.09 0.025" />
      </geometry>
    </collision>
    <!--Unreliable upstream placeholder mass/inertia retained only for faithful source expansion. Do not treat as calibrated physical parameters.-->
    <inertial>
      <mass value="0.072" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.003881243" ixy="0" ixz="0" iyy="0.000498940" iyz="0" izz="0.003879257" />
    </inertial>
  </link>
  <joint name="camera_depth_joint" type="fixed">
